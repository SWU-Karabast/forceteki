# Copy this file to .env for local development; npm run dev does this if .env is missing.
# Restart the dev server after changes; sign in again if the secret or hostname changes.
GAME_NODE_HOST="localhost"
GAME_NODE_NAME="test1"
GAME_NODE_SOCKET_IO_PORT="9500"
ENVIRONMENT="development"

# Must match NEXTAUTH_SECRET in the frontend .env.local. This default is for local development only.
# For other environments, generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="verysecret"

# For mobile testing, allow the frontend origin (port 3000), without a trailing slash.
# ADDITIONAL_CORS_ORIGINS="http://192.168.4.40:3000"

# Set to true to force the local dev server to use action timers in public games.
USE_LOCAL_ACTION_TIMER="false"
# Set to true to enable local DynamoDB for account testing; false uses in-memory storage.
USE_LOCAL_DYNAMODB="false"
DISCORD_BUG_REPORT_WEBHOOK_URL=""
DISCORD_PLAYER_REPORT_WEBHOOK_URL=""
DISCORD_ROLE_ASSIGNMENT_WEBHOOK_URL=""
DISCORD_ERROR_REPORT_WEBHOOK_URL=""
SWUSTATS_API_KEY=""
FORCE_ENABLE_STATS_LOGGING="false"
FORCE_BLOCK_BO3_ANON_LOCAL="false"
FORCE_ENABLE_ANON_CHAT="false"
